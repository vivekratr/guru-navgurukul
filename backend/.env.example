# Required for HTTP server (defaults apply if omitted)
NODE_ENV=development
PORT=3001

# Supabase API (required for Supabase JS client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database connection (required to apply migrations — from Dashboard → Settings → Database → Connection string → URI)
# Use the direct connection on port 5432, not the pooler, for migrations.
DATABASE_URL=

# Bearer token for the LLM gateway (OpenRouter API key, or OmniRoute dashboard key)
OPENROUTER_API_KEY=

# Optional — override chat completions endpoint (defaults to OpenRouter)
# OmniRoute local example:
# LLM_CHAT_COMPLETIONS_URL=http://localhost:20128/v1/chat/completions
LLM_CHAT_COMPLETIONS_URL=

# Optional — test-only failure injection for E2E ingest retry path
# TEST_FORCE_INGEST_FAILURE_ONCE=false
