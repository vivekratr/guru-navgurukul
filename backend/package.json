{
  "name": "@navgurukul/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/db-push.ts",
    "db:check": "tsx scripts/check-remote-schema.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
