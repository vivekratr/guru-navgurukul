{
  "name": "@navgurukul/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts' --exclude 'src/routes/**' --exclude 'src/test/rls-isolation.test.ts'",
    "test:integration": "vitest run '**/*.integration.test.ts' src/routes src/test/rls-isolation.test.ts",
    "test:e2e": "vitest run '**/*.e2e.test.ts'",
    "test:watch": "vitest",
    "db:push": "tsx scripts/db-push.ts",
    "db:check": "tsx scripts/check-remote-schema.ts",
    "deploy:ingest-function": "tsx scripts/deploy-ingest-function.ts",
    "worker:ingest": "tsx scripts/run-ingest-worker.ts",
    "worker:knowledge": "tsx scripts/run-knowledge-worker.ts",
    "worker:artifacts": "tsx scripts/run-artifact-worker.ts",
    "inspect:jobs": "tsx scripts/inspect-jobs.ts",
    "inspect:failed-jobs": "tsx scripts/inspect-jobs.ts --failed"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
