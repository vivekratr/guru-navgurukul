{
  "name": "@navgurukul/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:pipeline": "tsx scripts/dev-pipeline.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/schemas src/workers/ingest-worker.unit.test.ts src/workers/knowledge-worker.unit.test.ts src/workers/artifact-worker.unit.test.ts src/lib/csv.test.ts src/lib/llm/call-role.test.ts",
    "test:integration": "vitest run src/routes src/test/rls-isolation.test.ts src/workers/ingest-worker.integration.test.ts src/workers/knowledge-worker.integration.test.ts src/workers/artifact-worker.integration.test.ts src/lib/state-transitions.integration.test.ts src/lib/llm/model-role-config.integration.test.ts",
    "test:e2e": "vitest run src/e2e",
    "test:watch": "vitest",
    "db:push": "tsx scripts/db-push.ts",
    "db:check": "tsx scripts/check-remote-schema.ts",
    "deploy:ingest-function": "tsx scripts/deploy-ingest-function.ts",
    "schedule:ingest-cron": "tsx scripts/schedule-ingest-cron.ts",
    "unschedule:ingest-cron": "tsx scripts/unschedule-ingest-cron.ts",
    "worker:ingest": "tsx scripts/run-ingest-worker.ts",
    "worker:knowledge": "tsx scripts/run-knowledge-worker.ts",
    "worker:artifacts": "tsx scripts/run-artifact-worker.ts",
    "workers:watch": "tsx scripts/run-workers-watch.ts",
    "inspect:jobs": "tsx scripts/inspect-jobs.ts",
    "inspect:failed-jobs": "tsx scripts/inspect-jobs.ts --failed"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
